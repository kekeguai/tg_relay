# Telegram 消息中继 · 敏感参数（本文件不要提交到版本库）
#
# 优先级：进程环境变量 > .env > config.json
# 即：docker-compose 通过 env_file: .env 注入后，这些值会覆盖 config.json 中的同名字段。
# DEST_CHANNELS 若在 .env 中出现，按逗号分隔解析为数组，例如：
#   DEST_CHANNELS=-1001111111111,-1002222222222

API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
RELAY_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
